# Copy this file to .env.local and fill in real values.
#
# Local dev (after `supabase start`): the CLI prints these values in your
# terminal. They're also stable defaults for every local Supabase project:
#   NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=<printed by `supabase start`>
#
# Hosted project: Supabase Dashboard → Project Settings → API.

# Public — safe to expose to the browser. Used by both the browser and
# server Supabase clients.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Base URL this app is served from, used to build email redirect links
# (password reset, invitation accept) and OAuth/webhook callback URLs.
# Set to your Vercel/production URL when deploying; defaults to
# http://localhost:3000 in dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe Connect (Phase 2C payments) — server-only, never exposed to the
# browser. Use TEST MODE values while developing (Stripe Dashboard, toggle
# "Test mode" in the top right) so nothing here can move real money.
#
# STRIPE_SECRET_KEY: Dashboard → Developers → API keys → Secret key (sk_test_...)
# STRIPE_CONNECT_CLIENT_ID: Dashboard → Settings → Connect → OAuth settings
#   (ca_...). Register this app's callback URL there too:
#   http://localhost:3000/api/stripe/callback (or your deployed URL).
# STRIPE_WEBHOOK_SECRET: Dashboard → Developers → Webhooks → add a CONNECT
#   endpoint (not a regular/account endpoint) pointing at
#   <site-url>/api/webhooks/stripe, listening for checkout.session.completed.
#   For local dev, the Stripe CLI (`stripe listen --forward-to
#   localhost:3000/api/webhooks/stripe`) prints a whsec_... to use instead.
STRIPE_SECRET_KEY=
STRIPE_CONNECT_CLIENT_ID=
STRIPE_WEBHOOK_SECRET=
